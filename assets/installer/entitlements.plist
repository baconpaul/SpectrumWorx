<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
    Passed to codesign as `--entitlements` by sst-plugininfra's
    make_installer.sh, for every signed bundle in the installer.

    The JIT and unsigned-executable-memory pair are what a hardened-runtime
    plugin needs to be loadable by a host that generates code, and the audio
    input entitlement is what the standalone needs to open a capture device --
    without it macOS denies the microphone and the standalone runs deaf.

    SPDX-License-Identifier: GPL-3.0-or-later
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
